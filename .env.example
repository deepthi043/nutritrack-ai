# ============================================
# NutriTrack AI — Environment Configuration
# ============================================
# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

# --- Database ---
DATABASE_URL=postgresql://nutritrack:nutritrack@localhost/nutritrack_db

# --- JWT Auth ---
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
DEBUG=true
APP_NAME=NutriTrack AI
APP_VERSION=0.1.0

# --- CORS (comma-separated list handled by backend config) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- AI Service ---
# Never expose this key to the frontend. Used server-side only.
# AI_PROVIDER: "mock" (default — rule-based insights from real user data,
# no external calls, always works) or "llm" (calls an external AI API using
# AI_API_KEY below; automatically falls back to mock if the key is empty).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Email (password reset) ---
# Never expose this key to the frontend. Used server-side only.
# Get a free API key at https://resend.com. If left blank, the
# forgot-password endpoint logs the reset link server-side and returns it
# in the API response (dev mode) instead of emailing it — the flow still
# works fully with zero configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NutriTrack AI <onboarding@resend.dev>
# Base URL of the frontend, used to build the link inside the reset email.
FRONTEND_URL=http://localhost:5190
